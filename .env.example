# Travian API Configuration
# All three are required for authentication:
# Same username/password works across servers, but each server is a separate game world

# Game server URL (the specific world you're playing on)
TRAVIAN_BASE_URL=https://ts1.x1.europe.travian.com

# Login credentials
TRAVIAN_USERNAME=your_email@example.com
TRAVIAN_PASSWORD=your_password

# Background "recon" account (optional) — used by AutoScout for the
# read-only sweep work (map scanning, tile-details, player profile
# lookups). When set, every scout-related read goes through this
# disposable login so bot-detection / rate-limit pressure accumulates
# on the throwaway, not your primary account. The recon account MUST
# exist on the same Travian server as TRAVIAN_BASE_URL. Leave blank to
# disable; reads then fall back to the primary account.
TRAVIAN_RECON_USERNAME=
TRAVIAN_RECON_PASSWORD=

# Game client version (found in page source: gpack/{VERSION}/)
# Usually doesn't change often — 389 is current as of March 2026
TRAVIAN_X_VERSION=389

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
TRAVIAN_LOG_LEVEL=INFO

# Request timeout in seconds
TRAVIAN_TIMEOUT=30

# Live trade-route creation (Gold Club). Leave OFF.
# The /api/v1/trade-routes request body has never been captured from a real
# client, so the one the code builds is an educated guess. A request with wrong
# or extra fields is a bot fingerprint, which is the one thing the stealth layer
# exists to prevent — so this stays off until a real create request has been
# captured and TradeRouteService._build_create_payload confirmed against it.
# Preview (dry_run) works regardless and never touches the game.
TRAVIAN_TRADE_ROUTE_LIVE=false
